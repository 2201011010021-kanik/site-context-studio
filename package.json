{
  "name": "site-context-studio",
  "version": "0.1.36",
  "description": "A desktop and web studio for mapped site studies",
  "author": "Kaniks Studio",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "test:demo": "node --test demo-server.integration.mjs",
    "desktop": "electron .",
    "dist:win": "node scripts/make-desktop-icon.mjs && electron-builder --win nsis",
    "dist:mac": "node scripts/make-desktop-icon.mjs && electron-builder --mac dmg --arm64"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "studio.kaniks.sitecontext",
    "productName": "Site Context Studio",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "server.mjs",
      "accounts.mjs",
      "capture-store.mjs",
      "geo.mjs",
      "overpass-client.mjs",
      "overture-client.mjs",
      "place-search.mjs",
      "terrain.mjs",
      "site-insights.mjs",
      "trees.mjs",
      "package.json"
    ],
    "extraResources": [
      { "from": "dist/site-context-reader", "to": "site-context-reader" }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "artifactName": "Site-Context-Studio-Mac-${version}-${arch}.${ext}" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Site-Context-Studio-Setup-${version}.${ext}"
    }
  }
}
